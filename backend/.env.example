# Point this at your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Set this to an Ollama model that supports image input. There is no default model.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=180
FRONTEND_ORIGIN=http://localhost:3000

# PDF pages are rendered at this DPI before table detection (default: 200).
PDF_RENDER_DPI=200
