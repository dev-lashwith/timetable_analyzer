# Sarvam doc Intelligence is the only extraction provider.
# Get an API key from Sarvam and paste it here (never commit the real key).
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/doc-ai/v1

# HTTP request timeout and total time allowed for an extraction job.
SARVAM_REQUEST_TIMEOUT_SECONDS=60
SARVAM_JOB_TIMEOUT_SECONDS=900
SARVAM_POLL_INTERVAL_SECONDS=2

FRONTEND_ORIGIN=http://localhost:3000

# PDF pages are rendered at this DPI for the manual preview/discover views only (default: 200).
PDF_RENDER_DPI=200

# How many PDF pages are scanned in the manual preview/discover views (default: 20).
MAX_PDF_PAGES=20
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/timetable_extractor
STORAGE_DIR=./uploads
