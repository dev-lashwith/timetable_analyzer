# Point this at your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# The local vision model used for both timetable and whole-page extraction.
OLLAMA_MODEL=minicpm-v4.6:latest
OLLAMA_TIMEOUT_SECONDS=180
FRONTEND_ORIGIN=http://localhost:3000

# PDF pages are rendered at this DPI before table detection and page analysis (default: 200).
PDF_RENDER_DPI=200
MAX_PDF_PAGES=100
# Documents, page images, crops, and the SQLite database are stored here.
# Defaults to backend/data. Keep this directory on a local disk with enough space.
# TIMETABLE_STORAGE_DIR=C:/timetable-analyzer-data
